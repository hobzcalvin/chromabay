{
	"name": "chromabay",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host 0.0.0.0",
		"build": "vite build",
		"build:dev": "NODE_ENV=development VITE_LOCAL=1 vite build",
		"preview": "vite preview",
		"prepare": "husky",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"check": "npx svelte-kit sync && npx svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "npx svelte-kit sync && npx svelte-check --tsconfig ./tsconfig.json --watch",
		"sync": "npx cap sync",
		"deploy:docs": "npm run build",
		"ios": "npm run build:dev && npm run sync && npx cap run ios",
		"ios:phone": "npm run build:dev && npm run sync && npx cap open ios",
		"ios:live": "node scripts/bump-ios-build.mjs && npm run build && npm run sync && npx cap open ios",
		"ios:sim": "npm run build:dev && npm run sync && npx cap run ios --target=7F4BB4F6-1A1C-4163-8C3A-62C604278928",
		"ship:ios": "bash scripts/ios-release.sh",
		"android": "npm run build:dev && npm run sync && npx cap run android",
		"deploy": "npm run deploy:docs",
		"bundle:create": "node scripts/deploy-live-update.js",
		"bundle:live": "npm run build && node scripts/deploy-live-update.js",
		"clear-cache": "rm -rf .svelte-kit node_modules/.vite build docs && echo '✅ All caches cleared!'",
		"esp32:build": "cd esp32 && pio run",
		"esp32:upload": "NO_MONITOR=1 bash esp32/scripts/flash-dev.sh",
		"esp32:monitor": "cd esp32 && pio device monitor --baud 115200",
		"esp32:full": "bash esp32/scripts/flash-dev.sh",
		"drive": "node automation/drive.mjs",
		"verify:wasm": "node automation/verify-wasm.mjs",
		"verify:render": "node automation/verify-render.mjs",
		"wasm:compile": "bash native/build-wasm.sh"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@types/msgpack": "^0.0.34",
		"@types/node": "^24.0.6",
		"@vitest/ui": "^4.1.9",
		"chokidar": "^4.0.3",
		"gh-pages": "^6.3.0",
		"husky": "^9.1.7",
		"jsdom": "^29.1.1",
		"playwright": "^1.61.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.0.0",
		"vite": "^6.2.6",
		"vitest": "^4.1.9"
	},
	"dependencies": {
		"@capacitor-community/bluetooth-le": "^7.1.1",
		"@capacitor/android": "^7.2.0",
		"@capacitor/app": "^7.0.1",
		"@capacitor/cli": "^7.2.0",
		"@capacitor/core": "^7.2.0",
		"@capacitor/ios": "^7.2.0",
		"@capacitor/preferences": "^7.0.1",
		"@capawesome/capacitor-live-update": "^7.2.0",
		"@msgpack/msgpack": "^3.1.2",
		"@sentry/sveltekit": "^10.64.0",
		"@supabase/supabase-js": "^2.45.0",
		"@xyflow/svelte": "^1.0.2",
		"capacitor-plugin-ios-webview-configurator": "^0.4.0",
		"esp-web-tools": "^10.2.1",
		"pixi.js": "^8.10.1"
	},
	"allowScripts": {
		"esbuild@0.25.5": true,
		"fsevents@2.3.3": true
	}
}
