#!/bin/bash

# Get repository root directory
REPO_ROOT=$(git rev-parse --show-toplevel)

# Check if there are changes in the app directory
if git diff --cached --name-only | grep -q "^app/"; then
    echo -e "\nChanges detected in app directory"
    
    # Get current version from package.json
    CURRENT_VERSION=$(node -p "require('$REPO_ROOT/app/package.json').version")
    echo "Current version: $CURRENT_VERSION"
    
    # Prompt for new version
    exec < /dev/tty
    read -p "Create new React Native update? (y/n) " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        while true; do
            read -p "Enter new version (must be > $CURRENT_VERSION): " NEW_VERSION
            
            # Validate version format
            if ! [[ $NEW_VERSION =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
                echo "Error: Version must be in format x.y.z"
                continue
            fi
            
            # Compare versions
            IFS='.' read -r -a current <<< "$CURRENT_VERSION"
            IFS='.' read -r -a new <<< "$NEW_VERSION"
            
            version_valid=true
            for i in {0..2}; do
                if [ "${new[$i]}" -gt "${current[$i]}" ]; then
                    break
                elif [ "${new[$i]}" -lt "${current[$i]}" ]; then
                    echo "Error: New version must be greater than current version"
                    version_valid=false
                    break
                fi
            done
            
            if $version_valid; then
                break
            fi
        done
        
        # Create update package
        echo -e "\nCreating update package..."
        cd "$REPO_ROOT" && VERSION=$NEW_VERSION node package-update.js
        
        # Add update files to commit
        git add "$REPO_ROOT/docs/app-updates"
        
        # Update package.json version
        cd "$REPO_ROOT/app" && npm version $NEW_VERSION --no-git-tag-version
        git add "$REPO_ROOT/app/package.json"
    fi
    exec <&-
fi 