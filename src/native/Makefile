# Auto-generated Makefile - some parts generated by scripts/generate-native-code.js
# FastLED Operator Build System
# Builds operators with FastLED-compatible code for both WASM and ESP32

# Configuration
CC = gcc
CXX = g++
CFLAGS = -Wall -Wextra -g -DNATIVE_BUILD
CXXFLAGS = -Wall -Wextra -g -std=c++17 -DNATIVE_BUILD
INCLUDES = -I.

# FastLED library path
FASTLED_SRC = FastLED/src

# Minimal FastLED compatibility layer
FASTLED_SOURCES = fastled_minimal.cpp

# Source files
SOURCES = operator_registry.cpp $(wildcard operators/*.cpp) $(FASTLED_SOURCES)
HEADERS = fastled_operators.h

# Test executable
TEST_TARGET = test_operators
TEST_SOURCES = test_operators.cpp $(SOURCES)

# WASM build
WASM_TARGET = ../../static/wasm/fastled_operators.js
WASM_SOURCES = operator_registry.cpp $(wildcard operators/*.cpp) wasm_interface.cpp $(FASTLED_SOURCES)
EMCC_FLAGS = -O3 -s WASM=1 \
	-s EXPORTED_FUNCTIONS='["_create_context", "_destroy_context", "_set_timing", "_set_parameters", "_get_output_buffer", "_get_buffer_size", "_set_input_buffer1", "_set_input_buffer2", "_malloc", "_free", "_call_blend_operator", "_call_chase_operator", "_call_fade_operator", "_call_gradient_operator", "_call_moving_blob_operator", "_call_perlin_noise_operator", "_call_rainbow_operator", "_call_raindrops_operator", "_call_sparkle_operator", "_call_strobe_operator"]' \
	-s EXPORTED_RUNTIME_METHODS='["ccall", "cwrap", "setValue", "getValue", "HEAPU8"]' \
	-s ALLOW_MEMORY_GROWTH=1 \
	-s MODULARIZE=1 \
	-s EXPORT_NAME='FastLEDOperators' \
	-s ENVIRONMENT='web' \
	-s SINGLE_FILE=0 \
	-s USE_WEBGL2=0 \
	-s USE_GLFW=0 \
	-s STANDALONE_WASM=0 \
	-lm \
	-D__EMSCRIPTEN__ \
	-std=c++17 \
	$(INCLUDES)

# Default target
all: test

# Test build for native development
test: $(TEST_TARGET)

$(TEST_TARGET): $(TEST_SOURCES) $(HEADERS)
	$(CXX) $(CXXFLAGS) $(INCLUDES) $(TEST_SOURCES) -o $(TEST_TARGET)

# WASM build for web  
.PHONY: wasm
wasm:
	@mkdir -p ../../static/wasm
	@# Always check if rebuild is needed since wildcards don't work well with Make dependencies
	@REBUILD_NEEDED=0; \
	if [ ! -f $(WASM_TARGET) ]; then \
		echo "🔧 WASM target doesn't exist, building..."; \
		REBUILD_NEEDED=1; \
	elif [ -f $(WASM_TARGET) ] && [ $$(stat -f%z $(WASM_TARGET) 2>/dev/null || echo 0) -lt 1000 ]; then \
		echo "🔧 WASM target appears corrupted (too small), rebuilding..."; \
		REBUILD_NEEDED=1; \
	elif [ -n "$$(find operator_registry.cpp wasm_interface.cpp $(FASTLED_SOURCES) $(HEADERS) operators/ -newer $(WASM_TARGET) 2>/dev/null)" ]; then \
		echo "🔧 Source files changed, rebuilding WASM..."; \
		REBUILD_NEEDED=1; \
	fi; \
	if [ $$REBUILD_NEEDED -eq 1 ]; then \
		if command -v emcc >/dev/null 2>&1; then \
			EM_NODE_JS=$$(which node) emcc $(EMCC_FLAGS) $(WASM_SOURCES) -o $(WASM_TARGET); \
			echo "✅ WASM files built to static/wasm/"; \
		else \
			echo "❌ emcc not found. Run 'npm run setup:emscripten' first."; \
			exit 1; \
		fi; \
	else \
		echo "✅ WASM is up to date"; \
	fi

# Clean build artifacts
clean:
	rm -f ../../static/wasm/fastled_operators.js
	rm -f ../../static/wasm/fastled_operators.wasm
	rm -f $(TEST_TARGET)
	rm -f test_operators.dSYM/Contents/Resources/DWARF/test_operators
	@echo "Cleaned build artifacts"

# Install emscripten
install-emscripten:
	@echo "To install Emscripten:"
	@echo "1. git clone https://github.com/emscripten-core/emsdk.git"
	@echo "2. cd emsdk && ./emsdk install latest && ./emsdk activate latest"
	@echo "3. source ./emsdk_env.sh"

