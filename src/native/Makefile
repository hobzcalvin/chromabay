# FastLED Operator Build System
# Builds operators with FastLED-compatible code for both WASM and ESP32

# Configuration
CC = gcc
CXX = g++
CFLAGS = -Wall -Wextra -g -DNATIVE_BUILD
CXXFLAGS = -Wall -Wextra -g -std=c++17 -DNATIVE_BUILD
INCLUDES = -I.

# FastLED library path
FASTLED_SRC = FastLED/src

# Source files
SOURCES = operator_registry.cpp $(wildcard operators/*.cpp) fastled_compat.cpp
HEADERS = fastled_operators.h

# Test executable
TEST_TARGET = test_operators
TEST_SOURCES = test_operators.cpp $(SOURCES)

# WASM build
WASM_TARGET = ../../static/wasm/fastled_operators.js
WASM_SOURCES = operator_registry.cpp $(wildcard operators/*.cpp) wasm_interface.cpp fastled_compat.cpp
EMCC_FLAGS = -O3 -s WASM=1 \
	-s EXPORTED_FUNCTIONS='["_create_context", "_destroy_context", "_set_timing", "_set_parameters", "_get_output_buffer", "_get_buffer_size", "_malloc", "_free", "_call_gradient_operator", "_call_moving_blob_operator", "_call_perlin_noise_operator", "_call_rainbow_operator", "_call_sparkle_operator", "_call_strobe_operator"]' \
	-s EXPORTED_RUNTIME_METHODS='["ccall", "cwrap", "setValue", "getValue", "HEAPU8"]' \
	-s ALLOW_MEMORY_GROWTH=1 \
	-s MODULARIZE=1 \
	-s EXPORT_NAME='FastLEDOperators' \
	-s USE_WEBGL2=0 \
	-s USE_GLFW=0 \
	-D__EMSCRIPTEN__ \
	-std=c++17

# Default target
all: test

# Test build for native development
test: $(TEST_TARGET)

$(TEST_TARGET): $(TEST_SOURCES) $(HEADERS)
	$(CXX) $(CXXFLAGS) $(INCLUDES) $(TEST_SOURCES) -o $(TEST_TARGET)

# WASM build for web
wasm: $(WASM_TARGET)

$(WASM_TARGET): $(WASM_SOURCES) $(HEADERS)
	@mkdir -p ../../static/wasm
	emcc $(EMCC_FLAGS) $(WASM_SOURCES) -o $(WASM_TARGET)
	@echo "WASM files built to static/wasm/"

# Clean build artifacts
clean:
	rm -f ../../static/wasm/fastled_operators.js
	rm -f ../../static/wasm/fastled_operators.wasm
	rm -f $(TEST_TARGET)
	@echo "Cleaned build artifacts"

# Install emscripten
install-emscripten:
	@echo "To install Emscripten:"
	@echo "1. git clone https://github.com/emscripten-core/emsdk.git"
	@echo "2. cd emsdk && ./emsdk install latest && ./emsdk activate latest"
	@echo "3. source ./emsdk_env.sh"

