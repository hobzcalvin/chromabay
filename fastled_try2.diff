+// WebAssembly FastLED Patterns Integration
+// This file provides the bridge between the Svelte/TypeScript UI and the C++ FastLED WASM module
+
+import type { FastLEDPatternsModule } from './wasm/fastled_patterns';
+
+// WASM module instance
+let wasmModule: FastLEDPatternsModule | null = null;
+let moduleLoading: Promise<FastLEDPatternsModule> | null = null;
+
+// Pattern function wrappers
+interface WasmPatternFunctions {
+  render_rainbow: (ctxPtr: number) => void;
+  render_fire: (ctxPtr: number) => void;
+  render_gradient: (ctxPtr: number) => void;
+  render_perlin_noise: (ctxPtr: number) => void;
+  render_moving_blob: (ctxPtr: number) => void;
+  render_strobe: (ctxPtr: number) => void;
+  render_sparkle: (ctxPtr: number) => void;
+  render_blend: (ctxPtr: number, input1Ptr: number, input2Ptr: number) => void;
+  
+  init_rainbow: (ctxPtr: number) => void;
+  init_fire: (ctxPtr: number) => void;
+  init_gradient: (ctxPtr: number) => void;
+  init_perlin_noise: (ctxPtr: number) => void;
+  init_moving_blob: (ctxPtr: number) => void;
+  init_strobe: (ctxPtr: number) => void;
+  init_sparkle: (ctxPtr: number) => void;
+  init_blend: (ctxPtr: number) => void;
+}
+
+let wasmFunctions: WasmPatternFunctions | null = null;
+
+// Load WASM module
+async function loadWasmModule(): Promise<FastLEDPatternsModule> {
+  if (wasmModule) return wasmModule;
+  
+  if (moduleLoading) return moduleLoading;
+  
+  moduleLoading = (async () => {
+    try {
+      // Dynamic import of the WASM module (may not exist until built)
+      const FastLEDPatterns = (await import('./wasm/fastled_patterns.js')).default;
+      wasmModule = await FastLEDPatterns();
+      
+      // Wrap the exported functions for easier calling
+      wasmFunctions = {
+        render_rainbow: wasmModule.cwrap('render_rainbow', 'void', ['number']) as (ctxPtr: number) => void,
+        render_fire: wasmModule.cwrap('render_fire', 'void', ['number']) as (ctxPtr: number) => void,
+        render_gradient: wasmModule.cwrap('render_gradient', 'void', ['number']) as (ctxPtr: number) => void,
+        render_perlin_noise: wasmModule.cwrap('render_perlin_noise', 'void', ['number']) as (ctxPtr: number) => void,
+        render_moving_blob: wasmModule.cwrap('render_moving_blob', 'void', ['number']) as (ctxPtr: number) => void,
+        render_strobe: wasmModule.cwrap('render_strobe', 'void', ['number']) as (ctxPtr: number) => void,
+        render_sparkle: wasmModule.cwrap('render_sparkle', 'void', ['number']) as (ctxPtr: number) => void,
+        render_blend: wasmModule.cwrap('render_blend', 'void', ['number', 'number', 'number']) as (ctxPtr: number, input1Ptr: number, input2Ptr: number) => void,
+        
+        init_rainbow: wasmModule.cwrap('init_rainbow', 'void', ['number']) as (ctxPtr: number) => void,
+        init_fire: wasmModule.cwrap('init_fire', 'void', ['number']) as (ctxPtr: number) => void,
+        init_gradient: wasmModule.cwrap('init_gradient', 'void', ['number']) as (ctxPtr: number) => void,
+        init_perlin_noise: wasmModule.cwrap('init_perlin_noise', 'void', ['number']) as (ctxPtr: number) => void,
+        init_moving_blob: wasmModule.cwrap('init_moving_blob', 'void', ['number']) as (ctxPtr: number) => void,
+        init_strobe: wasmModule.cwrap('init_strobe', 'void', ['number']) as (ctxPtr: number) => void,
+        init_sparkle: wasmModule.cwrap('init_sparkle', 'void', ['number']) as (ctxPtr: number) => void,
+        init_blend: wasmModule.cwrap('init_blend', 'void', ['number']) as (ctxPtr: number) => void
+      };
+      
+      return wasmModule;
+    } catch (error) {
+      console.error('Failed to load FastLED WASM module:', error);
+      throw error;
+    }
+  })();
+  
+  return moduleLoading;
+}
+
+// RenderContext structure layout (must match C++ struct)
+interface WasmRenderContext {
+  pixel_buffer: number;     // Pointer to RGB buffer
+  width: number;           // Buffer width
+  height: number;          // Buffer height
+  total_time_ms: number;   // Total time in milliseconds
+  delta_time_ms: number;   // Delta time in milliseconds
+  parameters: number;      // Pointer to float array
+  param_count: number;     // Number of parameters
+}
+
+// Pattern definitions (must match C++ patterns)
+export const WASM_PATTERN_DEFINITIONS = [
+  {
+    name: 'Rainbow (Native)',
+    type: 'wasm_rainbow',
+    renderFunc: 'render_rainbow',
+    initFunc: 'init_rainbow',
+    params: [
+      { label: 'Speed', name: 'speed', type: 'float', default: 0.1, min: 0, max: 1 },
+      { label: 'Saturation', name: 'saturation', type: 'float', default: 1.0, min: 0, max: 1 },
+      { label: 'Value', name: 'value', type: 'float', default: 1.0, min: 0, max: 1 },
+      { label: 'Angle', name: 'angle', type: 'range', default: 0, min: 0, max: 360 }
+    ]
+  },
+  {
+    name: 'Fire (Native)',
+    type: 'wasm_fire',
+    renderFunc: 'render_fire',
+    initFunc: 'init_fire',
+    params: [
+      { label: 'Cooling', name: 'cooling', type: 'float', default: 55, min: 20, max: 100 },
+      { label: 'Sparking', name: 'sparking', type: 'float', default: 120, min: 50, max: 200 },
+      { label: 'Brightness', name: 'brightness', type: 'float', default: 255, min: 50, max: 255 }
+    ]
+  }
+  // Add more patterns as they're implemented
+];
+
+// Memory management helpers
+class WasmMemoryManager {
+  private allocatedPointers: Set<number> = new Set();
+  
+  allocateBuffer(size: number): number {
+    if (!wasmModule) throw new Error('WASM module not loaded');
+    
+    const ptr = wasmModule._malloc(size);
+    this.allocatedPointers.add(ptr);
+    return ptr;
+  }
+  
+  freeBuffer(ptr: number): void {
+    if (!wasmModule) return;
+    
+    if (this.allocatedPointers.has(ptr)) {
+      wasmModule._free(ptr);
+      this.allocatedPointers.delete(ptr);
+    }
+  }
+  
+  cleanup(): void {
+    if (!wasmModule) return;
+    
+    for (const ptr of this.allocatedPointers) {
+      wasmModule._free(ptr);
+    }
+    this.allocatedPointers.clear();
+  }
+}
+
+// Pattern runner that uses WASM functions
+export class WasmPatternRunner {
+  private memoryManager = new WasmMemoryManager();
+  private pixelBufferPtr: number = 0;
+  private parametersPtr: number = 0;
+  private contextPtr: number = 0;
+  private currentPattern: string = '';
+  private initialized = false;
+  
+  async initialize(): Promise<void> {
+    await loadWasmModule();
+  }
+  
+  async renderPattern(
+    patternType: string, 
+    width: number, 
+    height: number, 
+    totalTime: number, 
+    deltaTime: number, 
+    parameters: number[]
+  ): Promise<ImageData> {
+    if (!wasmModule || !wasmFunctions) {
+      throw new Error('WASM module not ready');
+    }
+    
+    const pixelCount = width * height;
+    const bufferSize = pixelCount * 3; // RGB
+    
+    // Allocate or reallocate buffers if needed
+    if (this.pixelBufferPtr === 0 || this.currentPattern !== patternType) {
+      this.cleanup();
+      
+      this.pixelBufferPtr = this.memoryManager.allocateBuffer(bufferSize);
+      this.parametersPtr = this.memoryManager.allocateBuffer(parameters.length * 4); // float32
+      this.contextPtr = this.memoryManager.allocateBuffer(32); // sizeof(RenderContext)
+      
+      this.currentPattern = patternType;
+      this.initialized = false;
+    }
+    
+    // Write parameters to WASM memory
+    const paramArray = new Float32Array(wasmModule.HEAPF32.buffer, this.parametersPtr, parameters.length);
+    paramArray.set(parameters);
+    
+    // Setup render context
+    const contextView = new DataView(wasmModule.HEAPU8.buffer, this.contextPtr, 32);
+    contextView.setUint32(0, this.pixelBufferPtr, true);  // pixel_buffer
+    contextView.setUint32(4, width, true);               // width
+    contextView.setUint32(8, height, true);              // height
+    contextView.setUint32(12, totalTime, true);          // total_time_ms
+    contextView.setUint32(16, deltaTime, true);          // delta_time_ms
+    contextView.setUint32(20, this.parametersPtr, true); // parameters
+    contextView.setUint32(24, parameters.length, true);  // param_count
+    
+    // Initialize pattern if needed
+    if (!this.initialized) {
+      const initFuncName = WASM_PATTERN_DEFINITIONS.find(p => p.type === patternType)?.initFunc;
+      if (initFuncName && wasmFunctions[initFuncName as keyof WasmPatternFunctions]) {
+        (wasmFunctions[initFuncName as keyof WasmPatternFunctions] as Function)(this.contextPtr);
+      }
+      this.initialized = true;
+    }
+    
+    // Call render function
+    const renderFuncName = WASM_PATTERN_DEFINITIONS.find(p => p.type === patternType)?.renderFunc;
+    if (renderFuncName && wasmFunctions[renderFuncName as keyof WasmPatternFunctions]) {
+      (wasmFunctions[renderFuncName as keyof WasmPatternFunctions] as Function)(this.contextPtr);
+    } else {
+      throw new Error(`Unknown pattern type: ${patternType}`);
+    }
+    
+    // Read pixel data from WASM memory
+    const pixelData = new Uint8Array(wasmModule.HEAPU8.buffer, this.pixelBufferPtr, bufferSize);
+    
+    // Convert RGB to RGBA for ImageData
+    const imageData = new ImageData(width, height);
+    for (let i = 0; i < pixelCount; i++) {
+      const srcOffset = i * 3;
+      const dstOffset = i * 4;
+      
+      imageData.data[dstOffset] = pixelData[srcOffset];         // R
+      imageData.data[dstOffset + 1] = pixelData[srcOffset + 1]; // G
+      imageData.data[dstOffset + 2] = pixelData[srcOffset + 2]; // B
+      imageData.data[dstOffset + 3] = 255;                      // A
+    }
+    
+    return imageData;
+  }
+  
+  cleanup(): void {
+    this.memoryManager.cleanup();
+    this.pixelBufferPtr = 0;
+    this.parametersPtr = 0;
+    this.contextPtr = 0;
+    this.initialized = false;
+  }
+}
+
+// Global pattern runner instance
+const globalWasmRunner = new WasmPatternRunner();
+
+// Convenience function for use in flowStore
+export async function renderWasmPattern(
+  patternType: string,
+  width: number,
+  height: number,
+  totalTime: number,
+  deltaTime: number,
+  parameters: number[]
+): Promise<ImageData> {
+  await globalWasmRunner.initialize();
+  return globalWasmRunner.renderPattern(patternType, width, height, totalTime, deltaTime, parameters);
+}
+
+// Initialize WASM module on first import
+loadWasmModule().catch(console.error); 
