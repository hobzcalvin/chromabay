+// ESP32 Example: Using the same FastLED pattern functions on hardware
+// This demonstrates how the same C++ code works on both WASM and ESP32
+
+#include <FastLED.h>
+#include "../fastled_patterns.h"
+
+// ESP32 hardware configuration
+#define LED_PIN     2
+#define NUM_LEDS    100
+#define LED_TYPE    WS2812B
+#define COLOR_ORDER GRB
+
+// LED array and pixel buffer
+CRGB leds[NUM_LEDS];
+uint8_t pixel_buffer[NUM_LEDS * 3]; // RGB buffer for pattern functions
+
+// Pattern parameters
+float pattern_params[4];
+
+// Render context for pattern functions
+RenderContext ctx;
+
+// Current pattern and timing
+void (*current_render_func)(RenderContext* ctx) = nullptr;
+void (*current_init_func)(RenderContext* ctx) = nullptr;
+unsigned long last_frame_time = 0;
+unsigned long start_time = 0;
+
+void setup() {
+    Serial.begin(115200);
+    Serial.println("FastLED Pattern Demo - ESP32");
+    
+    // Initialize FastLED
+    FastLED.addLeds<LED_TYPE, LED_PIN, COLOR_ORDER>(leds, NUM_LEDS);
+    FastLED.setBrightness(128);
+    FastLED.clear();
+    FastLED.show();
+    
+    // Setup render context
+    ctx.pixel_buffer = pixel_buffer;
+    ctx.width = NUM_LEDS;  // 1D strip treated as width x 1
+    ctx.height = 1;
+    ctx.parameters = pattern_params;
+    ctx.param_count = 4;
+    
+    // Initialize rainbow pattern (same function as WASM!)
+    pattern_params[0] = 0.1f;  // speed
+    pattern_params[1] = 1.0f;  // saturation  
+    pattern_params[2] = 1.0f;  // value
+    pattern_params[3] = 0.0f;  // angle
+    
+    current_render_func = render_rainbow;
+    current_init_func = init_rainbow;
+    
+    // Initialize pattern
+    if (current_init_func) {
+        current_init_func(&ctx);
+    }
+    
+    start_time = millis();
+    last_frame_time = start_time;
+    
+    Serial.println("Setup complete");
+}
+
+void loop() {
+    unsigned long current_time = millis();
+    
+    // Update timing in context
+    ctx.total_time_ms = current_time - start_time;
+    ctx.delta_time_ms = current_time - last_frame_time;
+    last_frame_time = current_time;
+    
+    // Call the same render function used in WASM!
+    if (current_render_func) {
+        current_render_func(&ctx);
+    }
+    
+    // Convert RGB buffer to CRGB array
+    for (int i = 0; i < NUM_LEDS; i++) {
+        leds[i].r = pixel_buffer[i * 3];
+        leds[i].g = pixel_buffer[i * 3 + 1];
+        leds[i].b = pixel_buffer[i * 3 + 2];
+    }
+    
+    // Display the pattern
+    FastLED.show();
+    
+    // Pattern switching demo (every 10 seconds)
+    if (ctx.total_time_ms > 10000 && current_render_func == render_rainbow) {
+        Serial.println("Switching to Fire pattern");
+        
+        // Switch to fire pattern with same functions as WASM
+        pattern_params[0] = 55.0f;   // cooling
+        pattern_params[1] = 120.0f;  // sparking  
+        pattern_params[2] = 255.0f;  // brightness
+        ctx.param_count = 3;
+        
+        current_render_func = render_fire;
+        current_init_func = init_fire;
+        
+        if (current_init_func) {
+            current_init_func(&ctx);
+        }
+    }
+    
+    // Limit frame rate
+    delay(20); // ~50 FPS
+}
+
+// Example of how to switch patterns dynamically
+void switchToPattern(const char* pattern_name) {
+    if (strcmp(pattern_name, "rainbow") == 0) {
+        pattern_params[0] = 0.1f;  // speed
+        pattern_params[1] = 1.0f;  // saturation  
+        pattern_params[2] = 1.0f;  // value
+        pattern_params[3] = 0.0f;  // angle
+        ctx.param_count = 4;
+        
+        current_render_func = render_rainbow;
+        current_init_func = init_rainbow;
+    }
+    else if (strcmp(pattern_name, "fire") == 0) {
+        pattern_params[0] = 55.0f;   // cooling
+        pattern_params[1] = 120.0f;  // sparking  
+        pattern_params[2] = 255.0f;  // brightness
+        ctx.param_count = 3;
+        
+        current_render_func = render_fire;
+        current_init_func = init_fire;
+    }
+    // Add more patterns here...
+    
+    // Initialize new pattern
+    if (current_init_func) {
+        current_init_func(&ctx);
+    }
+}
+
+// Example of real-time parameter adjustment
+void updatePatternParameters(float param1, float param2, float param3, float param4) {
+    pattern_params[0] = param1;
+    pattern_params[1] = param2;
+    pattern_params[2] = param3;
+    pattern_params[3] = param4;
+    
+    // Parameters take effect immediately on next render call
+} 
