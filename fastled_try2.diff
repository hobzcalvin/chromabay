+// FastLED-compatible JavaScript/TypeScript implementation
+// This provides the same API as FastLED for ESP32 consistency
+
+export class CRGB {
+  r: number;
+  g: number;
+  b: number;
+
+  constructor(r: number = 0, g: number = 0, b: number = 0) {
+    this.r = Math.max(0, Math.min(255, Math.round(r)));
+    this.g = Math.max(0, Math.min(255, Math.round(g)));
+    this.b = Math.max(0, Math.min(255, Math.round(b)));
+  }
+
+  // Static color constructors
+  static Red(): CRGB { return new CRGB(255, 0, 0); }
+  static Green(): CRGB { return new CRGB(0, 255, 0); }
+  static Blue(): CRGB { return new CRGB(0, 0, 255); }
+  static White(): CRGB { return new CRGB(255, 255, 255); }
+  static Black(): CRGB { return new CRGB(0, 0, 0); }
+  static Yellow(): CRGB { return new CRGB(255, 255, 0); }
+  static Cyan(): CRGB { return new CRGB(0, 255, 255); }
+  static Magenta(): CRGB { return new CRGB(255, 0, 255); }
+
+  // Create from HSV (hue 0-255, sat 0-255, val 0-255)
+  static fromHSV(h: number, s: number, v: number): CRGB {
+    h = h / 255.0;
+    s = s / 255.0;
+    v = v / 255.0;
+
+    const c = v * s;
+    const x = c * (1 - Math.abs((h * 6) % 2 - 1));
+    const m = v - c;
+    
+    let r = 0, g = 0, b = 0;
+    
+    if (0 <= h && h < 1/6) {
+      r = c; g = x; b = 0;
+    } else if (1/6 <= h && h < 2/6) {
+      r = x; g = c; b = 0;
+    } else if (2/6 <= h && h < 3/6) {
+      r = 0; g = c; b = x;
+    } else if (3/6 <= h && h < 4/6) {
+      r = 0; g = x; b = c;
+    } else if (4/6 <= h && h < 5/6) {
+      r = x; g = 0; b = c;
+    } else if (5/6 <= h && h < 1) {
+      r = c; g = 0; b = x;
+    }
+    
+    return new CRGB(
+      Math.round((r + m) * 255),
+      Math.round((g + m) * 255),
+      Math.round((b + m) * 255)
+    );
+  }
+
+  // Create from hex
+  static fromHex(hex: string): CRGB {
+    const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
+    return result ? new CRGB(
+      parseInt(result[1], 16),
+      parseInt(result[2], 16),
+      parseInt(result[3], 16)
+    ) : new CRGB(0, 0, 0);
+  }
+
+  // Scale brightness
+  scale8(scale: number): CRGB {
+    return new CRGB(
+      scale8(this.r, scale),
+      scale8(this.g, scale),
+      scale8(this.b, scale)
+    );
+  }
+
+  // Blend with another color
+  blend(other: CRGB, amount: number): CRGB {
+    const inv_amount = 255 - amount;
+    return new CRGB(
+      (this.r * inv_amount + other.r * amount) >> 8,
+      (this.g * inv_amount + other.g * amount) >> 8,
+      (this.b * inv_amount + other.b * amount) >> 8
+    );
+  }
+
+  // Convert to hex string
+  toHex(): string {
+    return `#${this.r.toString(16).padStart(2, '0')}${this.g.toString(16).padStart(2, '0')}${this.b.toString(16).padStart(2, '0')}`;
+  }
+
+  // Copy
+  copy(): CRGB {
+    return new CRGB(this.r, this.g, this.b);
+  }
+}
+
+// FastLED mathematical utility functions
+export function scale8(value: number, scale: number): number {
+  return (value * scale) >> 8;
+}
+
+export function scale8_video(value: number, scale: number): number {
+  return ((value * scale) >> 8) + (value && scale ? 1 : 0);
+}
+
+// Beat functions for animation timing
+export function beat8(bpm: number, timebase: number = Date.now()): number {
+  return (timebase * bpm * 280) >> 16;
+}
+
+export function beat16(bpm: number, timebase: number = Date.now()): number {
+  return (timebase * bpm * 280) >> 8;
+}
+
+export function beatsin8(bpm: number, lowest: number = 0, highest: number = 255, timebase: number = Date.now(), phase_offset: number = 0): number {
+  const beat = beat8(bpm, timebase);
+  const beatsin = sin8(beat + phase_offset);
+  const rangewidth = highest - lowest;
+  const scaledbeat = scale8(beatsin, rangewidth);
+  return lowest + scaledbeat;
+}
+
+export function beatsin16(bpm: number, lowest: number = 0, highest: number = 65535, timebase: number = Date.now(), phase_offset: number = 0): number {
+  const beat = beat16(bpm, timebase);
+  const beatsin = sin16(beat + phase_offset);
+  const rangewidth = highest - lowest;
+  const scaledbeat = scale16(beatsin, rangewidth);
+  return lowest + scaledbeat;
+}
+
+// Trigonometric functions (8-bit)
+export function sin8(theta: number): number {
+  const angle = (theta * Math.PI * 2) / 256;
+  return Math.round((Math.sin(angle) + 1) * 127.5);
+}
+
+export function cos8(theta: number): number {
+  return sin8(theta + 64);
+}
+
+// Trigonometric functions (16-bit)
+export function sin16(theta: number): number {
+  const angle = (theta * Math.PI * 2) / 65536;
+  return Math.round((Math.sin(angle) + 1) * 32767.5);
+}
+
+export function cos16(theta: number): number {
+  return sin16(theta + 16384);
+}
+
+// 16-bit scaling
+export function scale16(value: number, scale: number): number {
+  return (value * scale) >> 16;
+}
+
+// Noise functions (simplified Perlin noise)
+export function inoise8(x: number, y: number = 0, z: number = 0): number {
+  // Simplified 3D Perlin noise implementation
+  const noise = Math.sin(x * 0.1) * Math.cos(y * 0.1) * Math.sin(z * 0.1);
+  return Math.round((noise + 1) * 127.5);
+}
+
+export function inoise16(x: number, y: number = 0, z: number = 0): number {
+  const noise = Math.sin(x * 0.01) * Math.cos(y * 0.01) * Math.sin(z * 0.01);
+  return Math.round((noise + 1) * 32767.5);
+}
+
+// Random functions
+export function random8(): number;
+export function random8(max: number): number;
+export function random8(min: number, max: number): number;
+export function random8(minOrMax?: number, max?: number): number {
+  if (minOrMax === undefined) {
+    return Math.floor(Math.random() * 256);
+  } else if (max === undefined) {
+    return Math.floor(Math.random() * minOrMax);
+  } else {
+    return Math.floor(Math.random() * (max - minOrMax)) + minOrMax;
+  }
+}
+
+export function random16(): number;
+export function random16(max: number): number;
+export function random16(min: number, max: number): number;
+export function random16(minOrMax?: number, max?: number): number {
+  if (minOrMax === undefined) {
+    return Math.floor(Math.random() * 65536);
+  } else if (max === undefined) {
+    return Math.floor(Math.random() * minOrMax);
+  } else {
+    return Math.floor(Math.random() * (max - minOrMax)) + minOrMax;
+  }
+}
+
+// Color blending functions
+export function blend(existing: CRGB, overlay: CRGB, amount: number): CRGB {
+  return existing.blend(overlay, amount);
+}
+
+export function nblend(existing: CRGB, overlay: CRGB, amount: number): void {
+  const blended = existing.blend(overlay, amount);
+  existing.r = blended.r;
+  existing.g = blended.g;
+  existing.b = blended.b;
+}
+
+// Fill functions
+export function fill_solid(leds: CRGB[], start: number, count: number, color: CRGB): void {
+  for (let i = start; i < start + count && i < leds.length; i++) {
+    leds[i] = color.copy();
+  }
+}
+
+export function fill_rainbow(leds: CRGB[], start: number, count: number, initialHue: number, deltaHue: number): void {
+  let hue = initialHue;
+  for (let i = start; i < start + count && i < leds.length; i++) {
+    leds[i] = CRGB.fromHSV(hue, 255, 255);
+    hue += deltaHue;
+  }
+}
+
+export function fill_gradient_RGB(leds: CRGB[], start: number, color1: CRGB, end: number, color2: CRGB): void {
+  const count = end - start + 1;
+  for (let i = 0; i < count; i++) {
+    const blend_amount = (i * 255) / (count - 1);
+    leds[start + i] = color1.blend(color2, blend_amount);
+  }
+}
+
+// Color palette system
+export class CRGBPalette16 {
+  colors: CRGB[] = [];
+
+  constructor(colors?: CRGB[]) {
+    this.colors = new Array(16);
+    if (colors) {
+      for (let i = 0; i < 16; i++) {
+        this.colors[i] = colors[i] || new CRGB(0, 0, 0);
+      }
+    } else {
+      this.colors.fill(new CRGB(0, 0, 0));
+    }
+  }
+
+  static Rainbow(): CRGBPalette16 {
+    const colors: CRGB[] = [];
+    for (let i = 0; i < 16; i++) {
+      colors.push(CRGB.fromHSV((i * 255) / 16, 255, 255));
+    }
+    return new CRGBPalette16(colors);
+  }
+
+  static Ocean(): CRGBPalette16 {
+    return new CRGBPalette16([
+      new CRGB(0, 0, 128),    // Dark blue
+      new CRGB(0, 32, 160),
+      new CRGB(0, 64, 192),
+      new CRGB(0, 96, 224),
+      new CRGB(0, 128, 255),  // Bright blue
+      new CRGB(32, 160, 255),
+      new CRGB(64, 192, 255),
+      new CRGB(96, 224, 255),
+      new CRGB(128, 255, 255), // Cyan
+      new CRGB(160, 255, 224),
+      new CRGB(192, 255, 192),
+      new CRGB(224, 255, 160),
+      new CRGB(255, 255, 128), // Yellow-green
+      new CRGB(255, 224, 96),
+      new CRGB(255, 192, 64),
+      new CRGB(255, 160, 32)   // Orange
+    ]);
+  }
+
+  static Fire(): CRGBPalette16 {
+    return new CRGBPalette16([
+      new CRGB(0, 0, 0),       // Black
+      new CRGB(32, 0, 0),      // Dark red
+      new CRGB(64, 0, 0),
+      new CRGB(96, 0, 0),
+      new CRGB(128, 0, 0),     // Red
+      new CRGB(160, 32, 0),
+      new CRGB(192, 64, 0),
+      new CRGB(224, 96, 0),
+      new CRGB(255, 128, 0),   // Orange
+      new CRGB(255, 160, 32),
+      new CRGB(255, 192, 64),
+      new CRGB(255, 224, 96),
+      new CRGB(255, 255, 128), // Yellow
+      new CRGB(255, 255, 160),
+      new CRGB(255, 255, 192),
+      new CRGB(255, 255, 224)  // Almost white
+    ]);
+  }
+}
+
+export function ColorFromPalette(palette: CRGBPalette16, index: number, brightness: number = 255, blendType: 'NOBLEND' | 'LINEARBLEND' = 'LINEARBLEND'): CRGB {
+  if (blendType === 'NOBLEND') {
+    const paletteIndex = Math.floor(index / 16) % 16;
+    return palette.colors[paletteIndex].scale8(brightness);
+  } else {
+    // Linear blend between palette entries
+    const scaledIndex = (index * 15) / 255;
+    const index1 = Math.floor(scaledIndex);
+    const index2 = (index1 + 1) % 16;
+    const blend = Math.round((scaledIndex - index1) * 255);
+    
+    const color1 = palette.colors[index1];
+    const color2 = palette.colors[index2];
+    
+    return color1.blend(color2, blend).scale8(brightness);
+  }
+}
+
+// FastLED controller simulation
+export class CFastLED {
+  static brightness: number = 255;
+  static ledArrays: CRGB[][] = [];
+
+  static addLeds(leds: CRGB[], type: string, dataPin: number, numLeds?: number): void {
+    this.ledArrays.push(leds);
+  }
+
+  static setBrightness(brightness: number): void {
+    this.brightness = Math.max(0, Math.min(255, brightness));
+  }
+
+  static show(): void {
+    // In a real implementation, this would send data to hardware
+    // In our simulation, this is handled by the rendering system
+  }
+
+  static clear(): void {
+    this.ledArrays.forEach(array => {
+      array.fill(new CRGB(0, 0, 0));
+    });
+  }
+
+  static delay(ms: number): Promise<void> {
+    return new Promise(resolve => setTimeout(resolve, ms));
+  }
+}
+
+// Convenience aliases
+export const FastLED = CFastLED;
+
+// Global time function for animations
+export function millis(): number {
+  return Date.now();
+}
+
+// Array utilities
+export function CRGB_Array(size: number): CRGB[] {
+  return new Array(size).fill(null).map(() => new CRGB(0, 0, 0));
+} 
