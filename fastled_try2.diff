+# FastLED Patterns Build System
+# Supports both WebAssembly (Emscripten) and ESP32 (Arduino) builds
+
+# Default target
+.PHONY: all wasm esp32 clean
+
+all: wasm
+
+# WebAssembly build using Emscripten
+EMCC = emcc
+EMCC_FLAGS = -O3 \
+			 -s WASM=1 \
+			 -s EXPORTED_FUNCTIONS='["_render_rainbow", "_render_fire", "_render_gradient", "_render_perlin_noise", "_render_moving_blob", "_render_strobe", "_render_sparkle", "_render_blend", "_init_rainbow", "_init_fire", "_init_gradient", "_init_perlin_noise", "_init_moving_blob", "_init_strobe", "_init_sparkle", "_init_blend", "_malloc", "_free"]' \
+			 -s EXPORTED_RUNTIME_METHODS='["ccall", "cwrap"]' \
+			 -s ALLOW_MEMORY_GROWTH=1 \
+			 -s MODULARIZE=1 \
+			 -s EXPORT_NAME='FastLEDPatterns' \
+			 -I./fastled_wasm \
+			 -D__EMSCRIPTEN__
+
+WASM_SOURCES = patterns/rainbow.cpp \
+			   patterns/fire.cpp \
+			   patterns/gradient.cpp \
+			   patterns/perlin_noise.cpp \
+			   patterns/moving_blob.cpp \
+			   patterns/strobe.cpp \
+			   patterns/sparkle.cpp \
+			   patterns/blend.cpp \
+			   fastled_wasm/fastled_compatibility.cpp
+
+WASM_OUTPUT_DIR = ../lib/wasm
+WASM_OUTPUT = $(WASM_OUTPUT_DIR)/fastled_patterns
+
+# ESP32 build paths (for reference - typically built via PlatformIO)
+ESP32_SOURCES = patterns/rainbow.cpp \
+				patterns/fire.cpp \
+				patterns/gradient.cpp \
+				patterns/perlin_noise.cpp \
+				patterns/moving_blob.cpp \
+				patterns/strobe.cpp \
+				patterns/sparkle.cpp \
+				patterns/blend.cpp
+
+wasm: $(WASM_OUTPUT).js
+
+$(WASM_OUTPUT).js: $(WASM_SOURCES) fastled_patterns.h
+	@mkdir -p $(WASM_OUTPUT_DIR)
+	$(EMCC) $(EMCC_FLAGS) $(WASM_SOURCES) -o $(WASM_OUTPUT).js
+
+# Create TypeScript declarations for WASM module
+$(WASM_OUTPUT_DIR)/fastled_patterns.d.ts: $(WASM_OUTPUT).js
+	@echo "// Auto-generated TypeScript declarations for FastLED Patterns WASM module" > $@
+	@echo "" >> $@
+	@echo "export interface FastLEDPatternsModule {" >> $@
+	@echo "  ccall: (funcName: string, returnType: string, argTypes: string[], args: any[]) => any;" >> $@
+	@echo "  cwrap: (funcName: string, returnType: string, argTypes: string[]) => Function;" >> $@
+	@echo "  _malloc: (size: number) => number;" >> $@
+	@echo "  _free: (ptr: number) => void;" >> $@
+	@echo "  HEAPU8: Uint8Array;" >> $@
+	@echo "  HEAPF32: Float32Array;" >> $@
+	@echo "}" >> $@
+	@echo "" >> $@
+	@echo "declare const FastLEDPatterns: () => Promise<FastLEDPatternsModule>;" >> $@
+	@echo "export default FastLEDPatterns;" >> $@
+
+wasm-complete: $(WASM_OUTPUT).js $(WASM_OUTPUT_DIR)/fastled_patterns.d.ts
+
+# ESP32 build (typically done via PlatformIO or Arduino IDE)
+esp32:
+	@echo "ESP32 build should be done via PlatformIO or Arduino IDE"
+	@echo "Copy the following files to your ESP32 project:"
+	@echo "  - fastled_patterns.h"
+	@echo "  - patterns/*.cpp"
+	@echo "Example platformio.ini configuration:"
+	@echo "[env:esp32]"
+	@echo "platform = espressif32"
+	@echo "board = esp32dev"
+	@echo "framework = arduino"
+	@echo "lib_deps = fastled/FastLED@^3.5.0"
+
+# Clean build artifacts
+clean:
+	rm -rf $(WASM_OUTPUT_DIR)
+	@echo "Cleaned build artifacts"
+
+# Development helpers
+watch:
+	@echo "Watching for changes... (requires 'entr' command)"
+	find . -name "*.cpp" -o -name "*.h" | entr make wasm
+
+# Install dependencies (requires Emscripten SDK)
+install-deps:
+	@echo "Installing Emscripten SDK..."
+	@echo "Follow instructions at: https://emscripten.org/docs/getting_started/downloads.html"
+	@echo ""
+	@echo "Quick setup:"
+	@echo "  git clone https://github.com/emscripten-core/emsdk.git"
+	@echo "  cd emsdk"
+	@echo "  ./emsdk install latest"
+	@echo "  ./emsdk activate latest"
+	@echo "  source ./emsdk_env.sh"
+
+# Help
+help:
+	@echo "FastLED Patterns Build System"
+	@echo ""
+	@echo "Targets:"
+	@echo "  wasm          Build WebAssembly module for browser"
+	@echo "  wasm-complete Build WASM + TypeScript declarations"
+	@echo "  esp32         Show ESP32 build instructions"
+	@echo "  clean         Remove build artifacts"
+	@echo "  watch         Watch files and rebuild (requires entr)"
+	@echo "  install-deps  Show Emscripten installation instructions"
+	@echo "  help          Show this help" 
