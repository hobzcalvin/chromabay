+#ifndef FASTLED_PATTERNS_H
+#define FASTLED_PATTERNS_H
+
+#include <stdint.h>
+
+#ifdef __EMSCRIPTEN__
+// WebAssembly build - use emscripten FastLED
+#include "fastled_wasm.h"
+#else
+// ESP32 build - use standard FastLED
+#include <FastLED.h>
+#endif
+
+// Common render context structure
+typedef struct {
+    uint8_t* pixel_buffer;    // RGB pixel data (3 bytes per pixel)
+    uint32_t width;           // Buffer width in pixels
+    uint32_t height;          // Buffer height in pixels
+    uint32_t total_time_ms;   // Total elapsed time in milliseconds
+    uint32_t delta_time_ms;   // Time since last frame in milliseconds
+    float* parameters;        // Array of pattern parameters
+    uint32_t param_count;     // Number of parameters
+} RenderContext;
+
+// Pattern parameter definitions
+typedef struct {
+    const char* name;
+    float default_value;
+    float min_value;
+    float max_value;
+    uint8_t type; // 0=float, 1=int, 2=color, 3=select
+} PatternParameter;
+
+// Pattern definition structure
+typedef struct {
+    const char* name;
+    const PatternParameter* parameters;
+    uint32_t param_count;
+    void (*render_func)(RenderContext* ctx);
+    void (*init_func)(RenderContext* ctx); // Optional initialization
+} PatternDefinition;
+
+// Core FastLED-style render functions
+extern "C" {
+    // Rainbow pattern
+    void render_rainbow(RenderContext* ctx);
+    void init_rainbow(RenderContext* ctx);
+    
+    // Gradient pattern  
+    void render_gradient(RenderContext* ctx);
+    void init_gradient(RenderContext* ctx);
+    
+    // Perlin noise pattern
+    void render_perlin_noise(RenderContext* ctx);
+    void init_perlin_noise(RenderContext* ctx);
+    
+    // Fire pattern (Fire2012 algorithm)
+    void render_fire(RenderContext* ctx);
+    void init_fire(RenderContext* ctx);
+    
+    // Moving blob pattern
+    void render_moving_blob(RenderContext* ctx);
+    void init_moving_blob(RenderContext* ctx);
+    
+    // Strobe pattern
+    void render_strobe(RenderContext* ctx);
+    void init_strobe(RenderContext* ctx);
+    
+    // Sparkle pattern
+    void render_sparkle(RenderContext* ctx);
+    void init_sparkle(RenderContext* ctx);
+    
+    // Blend operation (takes two input buffers)
+    void render_blend(RenderContext* ctx, uint8_t* input1, uint8_t* input2);
+    void init_blend(RenderContext* ctx);
+}
+
+// Pattern registry - defined in fastled_patterns.cpp
+extern const PatternDefinition PATTERN_DEFINITIONS[];
+extern const uint32_t PATTERN_COUNT;
+
+// Utility functions for WASM/ESP32 compatibility
+inline void set_pixel_rgb(uint8_t* buffer, uint32_t index, uint8_t r, uint8_t g, uint8_t b) {
+    buffer[index * 3] = r;
+    buffer[index * 3 + 1] = g; 
+    buffer[index * 3 + 2] = b;
+}
+
+inline void get_pixel_rgb(uint8_t* buffer, uint32_t index, uint8_t* r, uint8_t* g, uint8_t* b) {
+    *r = buffer[index * 3];
+    *g = buffer[index * 3 + 1];
+    *b = buffer[index * 3 + 2];
+}
+
+// Convert linear index to 2D coordinates
+inline void index_to_xy(uint32_t index, uint32_t width, uint32_t* x, uint32_t* y) {
+    *x = index % width;
+    *y = index / width;
+}
+
+// Convert 2D coordinates to linear index
+inline uint32_t xy_to_index(uint32_t x, uint32_t y, uint32_t width) {
+    return y * width + x;
+}
+
+#endif // FASTLED_PATTERNS_H 
