+#include "../fastled_patterns.h"
+
+// Parameter indices for rainbow pattern
+enum RainbowParams {
+    PARAM_SPEED = 0,
+    PARAM_SATURATION = 1, 
+    PARAM_VALUE = 2,
+    PARAM_ANGLE = 3
+};
+
+// Rainbow pattern parameters definition
+static const PatternParameter rainbow_parameters[] = {
+    {"speed", 0.1f, 0.0f, 1.0f, 0},        // Speed (float)
+    {"saturation", 1.0f, 0.0f, 1.0f, 0},   // Saturation (float)
+    {"value", 1.0f, 0.0f, 1.0f, 0},        // Value/brightness (float)
+    {"angle", 0.0f, 0.0f, 360.0f, 0}       // Angle in degrees (float)
+};
+
+void init_rainbow(RenderContext* ctx) {
+    // No special initialization needed for rainbow
+    // Could initialize any static state here if needed
+}
+
+void render_rainbow(RenderContext* ctx) {
+    // Extract parameters
+    float speed = (ctx->param_count > PARAM_SPEED) ? ctx->parameters[PARAM_SPEED] : 0.1f;
+    float saturation = (ctx->param_count > PARAM_SATURATION) ? ctx->parameters[PARAM_SATURATION] : 1.0f;
+    float value = (ctx->param_count > PARAM_VALUE) ? ctx->parameters[PARAM_VALUE] : 1.0f;
+    float angle = (ctx->param_count > PARAM_ANGLE) ? ctx->parameters[PARAM_ANGLE] : 0.0f;
+    
+    // Scale parameters to FastLED ranges
+    speed *= 3.0f; // Scale for reasonable animation speed
+    uint8_t sat_8bit = (uint8_t)(saturation * 255);
+    uint8_t val_8bit = (uint8_t)(value * 255);
+    
+    // Convert angle to radians
+    float angle_rad = angle * M_PI / 180.0f;
+    float cos_angle = cos(angle_rad);
+    float sin_angle = sin(angle_rad);
+    
+    // Calculate total pixels
+    uint32_t total_pixels = ctx->width * ctx->height;
+    
+    // Time-based hue offset using FastLED's beat functions
+    uint8_t time_offset = beat8(speed * 60); // Convert to BPM-like value
+    
+    for (uint32_t i = 0; i < total_pixels; i++) {
+        uint32_t x, y;
+        index_to_xy(i, ctx->width, &x, &y);
+        
+        // Apply rotation to coordinates (same as original logic)
+        float rotated_x = x * cos_angle - y * sin_angle;
+        
+        // Calculate hue based on rotated position and time
+        // Use FastLED's scaling and math functions for consistency
+        uint8_t hue = time_offset + scale8((uint8_t)(rotated_x * 255 / ctx->width), 255);
+        
+        // Convert HSV to RGB using FastLED
+        CRGB color = CHSV(hue, sat_8bit, val_8bit);
+        
+        // Set pixel in buffer
+        set_pixel_rgb(ctx->pixel_buffer, i, color.r, color.g, color.b);
+    }
+}
+
+// Export pattern definition for registry
+extern "C" const PatternDefinition RAINBOW_PATTERN = {
+    "Rainbow",
+    rainbow_parameters,
+    sizeof(rainbow_parameters) / sizeof(PatternParameter),
+    render_rainbow,
+    init_rainbow
+}; 
