+// FastLED-style pattern implementations
+// These patterns use the same API that would work on ESP32 with FastLED
+
+import { 
+  CRGB, 
+  CRGB_Array, 
+  beatsin8, 
+  beat8, 
+  sin8, 
+  scale8,
+  fill_rainbow,
+  fill_solid,
+  blend,
+  inoise8,
+  random8,
+  CRGBPalette16,
+  ColorFromPalette,
+  millis
+} from './fastled';
+
+// Global LED array and constants (simulating ESP32 setup)
+export const NUM_LEDS = 100; // This will be dynamically set based on canvas size
+export let leds: CRGB[] = CRGB_Array(NUM_LEDS);
+
+// Pattern function interface - matches FastLED style
+export interface FastLEDPattern {
+  name: string;
+  setup?: () => void;
+  loop: (deltaTime: number) => void;
+  parameters: {
+    [key: string]: {
+      type: 'slider' | 'color' | 'select';
+      default: any;
+      min?: number;
+      max?: number;
+      options?: string[];
+    };
+  };
+}
+
+// FastLED-style Rainbow pattern
+export const RainbowPattern: FastLEDPattern = {
+  name: 'Rainbow',
+  parameters: {
+    speed: { type: 'slider', default: 30, min: 1, max: 100 },
+    density: { type: 'slider', default: 5, min: 1, max: 20 }
+  },
+  loop: (deltaTime) => {
+    const speed = getParameter('speed', 30);
+    const density = getParameter('density', 5);
+    
+    // This is exactly how you'd write it in FastLED on ESP32
+    fill_rainbow(leds, 0, leds.length, beat8(speed), 256 / density);
+  }
+};
+
+// FastLED-style Fire pattern
+export const FirePattern: FastLEDPattern = {
+  name: 'Fire',
+  parameters: {
+    cooling: { type: 'slider', default: 55, min: 20, max: 100 },
+    sparking: { type: 'slider', default: 120, min: 50, max: 200 },
+    brightness: { type: 'slider', default: 255, min: 50, max: 255 }
+  },
+  setup: () => {
+    // Initialize heat array
+    if (!(globalThis as any).heat) {
+      (globalThis as any).heat = new Array(NUM_LEDS).fill(0);
+    }
+  },
+  loop: (deltaTime) => {
+    const cooling = getParameter('cooling', 55);
+    const sparking = getParameter('sparking', 120);
+    const brightness = getParameter('brightness', 255);
+    
+    // Classic FastLED Fire2012 algorithm
+    const heat = (globalThis as any).heat || new Array(NUM_LEDS).fill(0);
+    
+    // Step 1: Cool down every cell a little
+    for (let i = 0; i < NUM_LEDS; i++) {
+      heat[i] = Math.max(0, heat[i] - random8(0, ((cooling * 10) / NUM_LEDS) + 2));
+    }
+    
+    // Step 2: Heat from each cell drifts up and diffuses slightly
+    for (let k = NUM_LEDS - 1; k >= 2; k--) {
+      heat[k] = (heat[k - 1] + heat[k - 2] + heat[k - 2]) / 3;
+    }
+    
+    // Step 3: Randomly ignite new sparks of heat near the bottom
+    if (random8() < sparking) {
+      const y = random8(7);
+      heat[y] = Math.min(255, heat[y] + random8(160, 255));
+    }
+    
+    // Step 4: Map from heat cells to LED colors
+    for (let j = 0; j < NUM_LEDS; j++) {
+      const t192 = scale8(heat[j], 192);
+      let heatcolor: CRGB;
+      
+      if (t192 > 128) {
+        // Hottest: white
+        heatcolor = new CRGB(255, 255, scale8(t192 - 128, 255));
+      } else if (t192 > 64) {
+        // Medium hot: red + orange
+        heatcolor = new CRGB(255, scale8(t192 - 64, 255), 0);
+      } else {
+        // Coolest: black + red
+        heatcolor = new CRGB(scale8(t192, 255), 0, 0);
+      }
+      
+      leds[j] = heatcolor.scale8(brightness);
+    }
+    
+    (globalThis as any).heat = heat;
+  }
+};
+
+// FastLED-style Noise pattern
+export const NoisePattern: FastLEDPattern = {
+  name: 'Noise',
+  parameters: {
+    speed: { type: 'slider', default: 20, min: 1, max: 100 },
+    scale: { type: 'slider', default: 30, min: 10, max: 100 }
+  },
+  loop: (deltaTime) => {
+    const speed = getParameter('speed', 20);
+    const scale = getParameter('scale', 30);
+    
+    const time = millis() / 10;
+    
+    for (let i = 0; i < leds.length; i++) {
+      const noise = inoise8(i * scale, time * speed);
+      const hue = (noise + i * 2) % 256;
+      leds[i] = CRGB.fromHSV(hue, 255, noise);
+    }
+  }
+};
+
+// FastLED-style Palette pattern
+export const PalettePattern: FastLEDPattern = {
+  name: 'Palette',
+  parameters: {
+    palette: { 
+      type: 'select', 
+      default: 'rainbow', 
+      options: ['rainbow', 'ocean', 'fire', 'forest'] 
+    },
+    speed: { type: 'slider', default: 50, min: 1, max: 100 },
+    brightness: { type: 'slider', default: 255, min: 50, max: 255 }
+  },
+  loop: (deltaTime) => {
+    const paletteType = getParameter('palette', 'rainbow');
+    const speed = getParameter('speed', 50);
+    const brightness = getParameter('brightness', 255);
+    
+    // Select palette based on parameter
+    let palette: CRGBPalette16;
+    switch (paletteType) {
+      case 'ocean': palette = CRGBPalette16.Ocean(); break;
+      case 'fire': palette = CRGBPalette16.Fire(); break;
+      case 'forest': 
+        palette = new CRGBPalette16([
+          new CRGB(0, 50, 0), new CRGB(0, 100, 0), new CRGB(50, 150, 0),
+          new CRGB(100, 200, 50), new CRGB(0, 80, 0), new CRGB(20, 120, 20),
+          new CRGB(40, 160, 40), new CRGB(0, 60, 0), new CRGB(60, 180, 60),
+          new CRGB(80, 200, 80), new CRGB(0, 40, 0), new CRGB(100, 220, 100),
+          new CRGB(120, 240, 120), new CRGB(0, 30, 0), new CRGB(140, 255, 140),
+          new CRGB(160, 255, 160)
+        ]);
+        break;
+      default: palette = CRGBPalette16.Rainbow(); break;
+    }
+    
+    const startIndex = beat8(speed);
+    
+    for (let i = 0; i < leds.length; i++) {
+      const colorIndex = startIndex + (i * 3);
+      leds[i] = ColorFromPalette(palette, colorIndex, brightness);
+    }
+  }
+};
+
+// FastLED-style Breathing pattern
+export const BreathingPattern: FastLEDPattern = {
+  name: 'Breathing',
+  parameters: {
+    color: { type: 'color', default: '#3b82f6' },
+    bpm: { type: 'slider', default: 60, min: 10, max: 120 }
+  },
+  loop: (deltaTime) => {
+    const color = CRGB.fromHex(getParameter('color', '#3b82f6'));
+    const bpm = getParameter('bpm', 60);
+    
+    const brightness = beatsin8(bpm, 64, 255);
+    const scaledColor = color.scale8(brightness);
+    
+    fill_solid(leds, 0, leds.length, scaledColor);
+  }
+};
+
+// FastLED-style Sparkle pattern
+export const SparklePattern: FastLEDPattern = {
+  name: 'Sparkle',
+  parameters: {
+    baseColor: { type: 'color', default: '#000080' },
+    sparkleColor: { type: 'color', default: '#ffffff' },
+    density: { type: 'slider', default: 10, min: 1, max: 50 }
+  },
+  loop: (deltaTime) => {
+    const baseColor = CRGB.fromHex(getParameter('baseColor', '#000080'));
+    const sparkleColor = CRGB.fromHex(getParameter('sparkleColor', '#ffffff'));
+    const density = getParameter('density', 10);
+    
+    // Fill with base color
+    fill_solid(leds, 0, leds.length, baseColor);
+    
+    // Add random sparkles
+    for (let i = 0; i < leds.length; i++) {
+      if (random8() < density) {
+        leds[i] = sparkleColor;
+      }
+    }
+  }
+};
+
+// Pattern registry
+export const FASTLED_PATTERNS: FastLEDPattern[] = [
+  RainbowPattern,
+  FirePattern,
+  NoisePattern,
+  PalettePattern,
+  BreathingPattern,
+  SparklePattern
+];
+
+// Parameter storage (simulates global variables on ESP32)
+const patternParameters = new Map<string, any>();
+
+export function setParameter(name: string, value: any): void {
+  patternParameters.set(name, value);
+}
+
+export function getParameter(name: string, defaultValue: any): any {
+  return patternParameters.get(name) ?? defaultValue;
+}
+
+// Initialize LED array for given dimensions
+export function initializeLEDs(width: number, height: number): void {
+  const newLength = width * height;
+  if (leds.length !== newLength) {
+    leds = CRGB_Array(newLength);
+  }
+}
+
+// Convert LED array to ImageData for canvas rendering
+export function ledsToImageData(width: number, height: number): ImageData {
+  const imageData = new ImageData(width, height);
+  const data = imageData.data;
+  
+  for (let i = 0; i < leds.length && i < width * height; i++) {
+    const led = leds[i];
+    const dataIndex = i * 4;
+    
+    data[dataIndex] = led.r;     // Red
+    data[dataIndex + 1] = led.g; // Green
+    data[dataIndex + 2] = led.b; // Blue
+    data[dataIndex + 3] = 255;   // Alpha
+  }
+  
+  return imageData;
+}
+
+// Pattern execution context - matches ESP32 FastLED usage
+export class FastLEDPatternRunner {
+  private currentPattern: FastLEDPattern | null = null;
+  private lastTime = 0;
+  
+  setPattern(pattern: FastLEDPattern): void {
+    this.currentPattern = pattern;
+    if (pattern.setup) {
+      pattern.setup();
+    }
+  }
+  
+  update(currentTime: number): void {
+    if (!this.currentPattern) return;
+    
+    const deltaTime = currentTime - this.lastTime;
+    this.lastTime = currentTime;
+    
+    this.currentPattern.loop(deltaTime / 1000); // Convert to seconds
+  }
+  
+  render(width: number, height: number): ImageData {
+    initializeLEDs(width, height);
+    return ledsToImageData(width, height);
+  }
+} 
