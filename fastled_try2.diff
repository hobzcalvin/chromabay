@@ -0,0 +1,148 @@
+#include "../fastled_patterns.h"
+#include <stdlib.h>
+
+// Maximum supported LED count for fire pattern
+#define MAX_FIRE_LEDS 1000
+
+// Static heat array for fire pattern (shared across all instances)
+// In a production system, this might be per-instance state
+static uint8_t heat[MAX_FIRE_LEDS];
+static bool fire_initialized = false;
+
+// Parameter indices
+enum FireParams {
+    PARAM_COOLING = 0,
+    PARAM_SPARKING = 1,
+    PARAM_BRIGHTNESS = 2
+};
+
+// Fire pattern parameters
+static const PatternParameter fire_parameters[] = {
+    {"cooling", 55.0f, 20.0f, 100.0f, 0},     // Cooling rate
+    {"sparking", 120.0f, 50.0f, 200.0f, 0},   // Sparking rate  
+    {"brightness", 255.0f, 50.0f, 255.0f, 0}  // Overall brightness
+};
+
+void init_fire(RenderContext* ctx) {
+    if (!fire_initialized) {
+        // Initialize heat array to zero
+        for (int i = 0; i < MAX_FIRE_LEDS; i++) {
+            heat[i] = 0;
+        }
+        fire_initialized = true;
+    }
+}
+
+void render_fire(RenderContext* ctx) {
+    // Extract parameters
+    float cooling = (ctx->param_count > PARAM_COOLING) ? ctx->parameters[PARAM_COOLING] : 55.0f;
+    float sparking = (ctx->param_count > PARAM_SPARKING) ? ctx->parameters[PARAM_SPARKING] : 120.0f;
+    float brightness = (ctx->param_count > PARAM_BRIGHTNESS) ? ctx->parameters[PARAM_BRIGHTNESS] : 255.0f;
+    
+    uint32_t total_pixels = ctx->width * ctx->height;
+    uint32_t num_leds = (total_pixels > MAX_FIRE_LEDS) ? MAX_FIRE_LEDS : total_pixels;
+    
+    // Step 1: Cool down every cell a little
+    for (uint32_t i = 0; i < num_leds; i++) {
+        // Use FastLED's random8 function for consistency
+        uint8_t cooling_amount = random8(0, ((uint8_t)cooling * 10) / num_leds + 2);
+        if (cooling_amount > heat[i]) {
+            heat[i] = 0;
+        } else {
+            heat[i] = heat[i] - cooling_amount;
+        }
+    }
+    
+    // Step 2: Heat from each cell drifts up and diffuses slightly
+    for (int k = num_leds - 1; k >= 2; k--) {
+        heat[k] = (heat[k - 1] + heat[k - 2] + heat[k - 2]) / 3;
+    }
+    
+    // Step 3: Randomly ignite new sparks near bottom
+    if (random8() < (uint8_t)sparking) {
+        int y = random8(7);
+        if (y < (int)num_leds) {
+            heat[y] = qadd8(heat[y], random8(160, 255)); // Use FastLED's qadd8 for safe addition
+        }
+    }
+    
+    // Step 4: Convert heat to LED colors using FastLED color mapping
+    for (uint32_t j = 0; j < num_leds; j++) {
+        CRGB color;
+        
+        // Heat-to-color mapping (classic Fire2012 algorithm)
+        uint8_t t192 = scale8_video(heat[j], 192); // Use FastLED's scale8_video
+        
+        uint8_t heatramp = t192 & 0x3F; // 0..63
+        heatramp <<= 2; // scale to 0..252
+        
+        if (t192 & 0x80) {
+            // Hottest: red -> orange -> yellow -> white
+            color.r = 255;
+            color.g = 255;
+            color.b = heatramp;
+        } else if (t192 & 0x40) {
+            // Medium: red -> orange
+            color.r = 255;
+            color.g = heatramp;
+            color.b = 0;
+        } else {
+            // Coolest: black -> red
+            color.r = heatramp;
+            color.g = 0;
+            color.b = 0;
+        }
+        
+        // Apply brightness scaling using FastLED function
+        color.nscale8_video((uint8_t)brightness);
+        
+        // For 2D rendering, we'll map the 1D fire effect across the width
+        if (j < num_leds && j < total_pixels) {
+            uint32_t x, y;
+            index_to_xy(j, ctx->width, &x, &y);
+            
+            // Map fire effect vertically (bottom-up)
+            uint32_t fire_index = ((ctx->height - 1 - y) * num_leds) / ctx->height;
+            if (fire_index < num_leds) {
+                CRGB fire_color;
+                uint8_t heat_val = heat[fire_index];
+                
+                // Same heat-to-color conversion
+                uint8_t t192 = scale8_video(heat_val, 192);
+                uint8_t heatramp = t192 & 0x3F;
+                heatramp <<= 2;
+                
+                if (t192 & 0x80) {
+                    fire_color.r = 255;
+                    fire_color.g = 255;
+                    fire_color.b = heatramp;
+                } else if (t192 & 0x40) {
+                    fire_color.r = 255;
+                    fire_color.g = heatramp;
+                    fire_color.b = 0;
+                } else {
+                    fire_color.r = heatramp;
+                    fire_color.g = 0;
+                    fire_color.b = 0;
+                }
+                
+                fire_color.nscale8_video((uint8_t)brightness);
+                set_pixel_rgb(ctx->pixel_buffer, j, fire_color.r, fire_color.g, fire_color.b);
+            }
+        }
+    }
+    
+    // Fill remaining pixels with black if any
+    for (uint32_t j = num_leds; j < total_pixels; j++) {
+        set_pixel_rgb(ctx->pixel_buffer, j, 0, 0, 0);
+    }
+}
+
+// Export pattern definition
+extern "C" const PatternDefinition FIRE_PATTERN = {
+    "Fire",
+    fire_parameters,
+    sizeof(fire_parameters) / sizeof(PatternParameter),
+    render_fire,
+    init_fire
+}; 
